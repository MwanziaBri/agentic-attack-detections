# Agentic attack detections by ThreatDefence: RedAmon
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3808001-3808499. HTTP rules need cleartext HTTP or decrypted traffic.
# The stock console (3000) and agent API (8090) are plain HTTP, so their rules work without decryption.

# --- Requests that reach your targets ---
alert http any any -> any any (msg:"TD RedAmon user agent"; flow:established,to_server; http.user_agent; content:"RedAmon"; fast_pattern; classtype:web-application-attack; sid:3808001; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family RedAmon;)
alert http any any -> any any (msg:"TD RedAmon MCP handshake client name"; flow:established,to_server; http.request_body; content:"|22|clientInfo|22|"; content:"RedAmon-AISurfaceRecon"; fast_pattern; classtype:web-application-attack; sid:3808002; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family RedAmon;)
alert http any any -> any any (msg:"TD RedAmon AI endpoint probe body"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"|22|model|22 3a 20 22|probe|22|"; fast_pattern; content:"|22|content|22 3a 20 22|ping|22|"; distance:0; classtype:web-application-attack; sid:3808003; rev:1; metadata:created_at 2026_11_23, confidence Medium, malware_family RedAmon;)
alert http any any -> $HTTP_SERVERS any (msg:"TD RedAmon cache poisoning canary host"; flow:established,to_server; http.header; content:".redamon-poc.invalid"; nocase; fast_pattern; classtype:web-application-attack; sid:3808004; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family RedAmon;)
alert http any any -> $HTTP_SERVERS any (msg:"TD RedAmon XSS canary in URI"; flow:established,to_server; http.uri; content:"rEdAm0n1337XsS"; fast_pattern; classtype:web-application-attack; sid:3808005; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family RedAmon;)
alert http any any -> $HTTP_SERVERS any (msg:"TD RedAmon XSS canary in a header"; flow:established,to_server; http.header; content:"rEdAm0n1337XsS"; fast_pattern; classtype:web-application-attack; sid:3808006; rev:1; metadata:created_at 2026_11_23, confidence High, malware_family RedAmon;)
alert dns any any -> any any (msg:"TD RedAmon ownership check lookup"; dns.query; content:"_redamon-verify."; startswith; nocase; classtype:policy-violation; sid:3808007; rev:1; metadata:created_at 2026_11_23, confidence Low, malware_family RedAmon;)

# --- An exposed RedAmon console (3000) or agent API (8090) ---
alert http any any -> any any (msg:"TD RedAmon console page"; flow:established,to_client; http.response_body; content:"<title>RedAmon</title>"; fast_pattern; classtype:policy-violation; sid:3808008; rev:1; metadata:created_at 2026_11_23, confidence Low, malware_family RedAmon;)
alert http any any -> any any (msg:"TD RedAmon console theme script (survives a renamed title)"; flow:established,to_client; http.response_body; content:"localStorage.getItem('redamon-theme')"; fast_pattern; classtype:policy-violation; sid:3808009; rev:1; metadata:created_at 2026_11_23, confidence Low, malware_family RedAmon;)
alert http any any -> any any (msg:"TD RedAmon agent API"; flow:established,to_client; http.response_body; content:"RedAmon Agent API"; fast_pattern; classtype:policy-violation; sid:3808010; rev:1; metadata:created_at 2026_11_23, confidence Low, malware_family RedAmon;)
